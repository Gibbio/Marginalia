<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox: on by default. Protects the user's disk from stray
         writes and is a prerequisite for a future Mac App Store pipeline.
         Direct-distribution users get the same protections. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Microphone is always needed: STT commands + note dictation. Both
         entitlements are required — `device.microphone` is the sandbox
         mic gate, `device.audio-input` the TCC prompt. -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Files imported via NSOpenPanel / drag-and-drop. Read-write so the
         runtime can also cache synthesized audio next to the user's
         document directory when they drop a folder. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Network access is GATED by the UI's Installations section only.
         Keep this entitlement present so the first-run downloader works;
         the app enforces "no other network access" at the code level
         (see HF_HUB_OFFLINE=1 in the runtime). -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
